<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:paddingTop="16dp"
    android:background="@color/background_dark"
    android:layout_height="match_parent">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_dark"
        android:title="Detalhes do Instrutor"
        android:titleTextColor="@android:color/black"
        app:navigationIcon="@drawable/outline_arrow_circle_left_24"
        app:titleCentered="true"/>

    <!-- Conteúdo principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:paddingBottom="100dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Profile Header -->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgInstrutor"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerInside"
                    android:contentDescription="Foto do Instrutor"
                    app:tint="@color/white"
                    app:shapeAppearanceOverlay="@style/CircularImageView"/>


                <TextView
                    android:id="@+id/txtNomeInstrutor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mariana Alves"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtDisponibilidade"
                        android:text="Disponível"
                        android:textColor="@color/accent_green"
                        android:textSize="14sp"
                        android:layout_height="wrap_content"
                         android:layout_width="wrap_content"/>



                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="10dp"
                        android:id="@+id/txtNota"
                        android:drawablePadding="5dp"
                        android:drawableEnd="@drawable/ic_star"
                        android:text="4.8"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Informações -->

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtTelefoneInstrutor"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:text="(11) 98765-4321"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:textColor="@color/white"
                        android:drawableStart="@drawable/ic_check_circule"
                        android:drawablePadding="10dp"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/txtCNHInstrutor"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:text="CNH Categoria AB"
                        android:gravity="center_vertical"
                        android:drawablePadding="10dp"
                        android:paddingStart="10dp"
                        android:textColor="@color/white"
                        android:drawableStart="@drawable/ic_check_circule"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/txtExperienciaInstrutor"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:text="5 anos de experiência"
                        android:gravity="center_vertical"
                        android:drawablePadding="10dp"
                        android:paddingStart="10dp"
                        android:textColor="@color/white"
                        android:drawableStart="@drawable/ic_check_circule"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/txtVeiculoInstrutor"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:text="Veiculo: Fiat Argo 1.0"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:textColor="@color/white"
                        android:drawablePadding="10dp"
                        android:drawableStart="@drawable/ic_check_circule"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/data"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:hint="Selecione uma Data"
                        android:textColorHint="@color/white"
                        android:gravity="center_vertical"
                        android:drawablePadding="10dp"
                        android:paddingStart="10dp"
                        android:drawableStart="@drawable/ic_check_circule"
                        android:textSize="16sp"/>

                    <Spinner
                        android:id="@+id/spinnerHorarios"
                        android:layout_height="60dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input"
                        android:entries="@array/horarios_array"
                        android:spinnerMode="dropdown"
                        android:textColor="@color/white"
                        android:layout_marginTop="10dp"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>





                </LinearLayout>

            <!-- Price Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Valor da Aula"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtPrecoAula"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="R$ 50,00 / 50 min"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Botão Solicitar Aula -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSolicitarAula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text="Solicitar Aula"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/black"
        android:layout_margin="16dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
