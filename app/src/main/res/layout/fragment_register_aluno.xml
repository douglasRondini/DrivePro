<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/outline_arrow_circle_left_24"
                android:background="@android:color/transparent"
                android:contentDescription="Voltar"/>
        </LinearLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crie sua Conta"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

        <!-- Nome Completo -->
        <EditText
            android:id="@+id/inputNome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="15dp"
            android:hint="Digite seu nome completo"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:background="@drawable/bg_input"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- Cidade -->
        <EditText
            android:id="@+id/inputCidade"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="15dp"
            android:hint="Digite sua cidade"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:background="@drawable/bg_input"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- E-mail -->
        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="15dp"
            android:hint="seuemail@exemplo.com"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:background="@drawable/bg_input"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <!-- CPF -->
        <EditText
            android:id="@+id/inputCpf"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="15dp"
            android:hint="000.000.000-00"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:background="@drawable/bg_input"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Telefone -->
        <EditText
            android:id="@+id/inputTelefone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="15dp"
            android:hint="(00) 00000-0000"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:background="@drawable/bg_input"
            android:inputType="phone"
            android:layout_marginBottom="16dp"/>

        <!-- Senha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/inputSenha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="********"
                android:inputType="textPassword"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
                android:background="@android:color/transparent"
                android:paddingStart="15dp"/>

            <ImageView
                android:id="@+id/iconVisibility"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_eyes_24"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Botão Cadastrar -->
        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cadastrar"
            android:textStyle="bold"
            android:textColor="@color/background_dark"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="24dp"/>

        <!-- Link Login -->
        <TextView
            android:id="@+id/linkLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Já tem uma conta? Faça login"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <!-- Footer -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ao se cadastrar, você concorda com nossos Termos de Serviço e Política de Privacidade."
            android:textColor="@color/gray"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
