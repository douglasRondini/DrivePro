<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_dark"
        app:navigationIcon="@drawable/outline_arrow_circle_left_24"
        app:title="Status da Solicitação"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"/>

    <!-- Conteúdo principal -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp">

        <!-- Status Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgInstrutor"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@color/accent_green"
            android:src="@drawable/ic_check_circule"
            android:scaleType="centerCrop"
            android:contentDescription="Foto do Instrutor"
            app:shapeAppearanceOverlay="@style/CircularImageView"/>

        <!-- Headline Text -->
        <TextView
            android:id="@+id/txtHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicitação Enviada"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Body Text -->
        <TextView
            android:id="@+id/txtBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Você será notificado quando o instrutor confirmar a aula."
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Card com detalhes -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Instrutor:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtInstrutor"
                        android:text="Carlos Silva"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="Data:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtData"
                        android:text="25 de Outubro, 2024"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Horário:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtHorario"
                        android:text="14:00"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botões de ação -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerSolicitacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Minhas Solicitações"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/background_dark"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar ao Início"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
