<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="16dp"
    android:background="@color/background_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/background_dark">

        <ImageView
            android:id="@+id/iconLocation"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_location_on"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Instrutores em São Paulo"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btnNotifications"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notifications"
            app:tint="@color/white"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"/>
    </LinearLayout>

    <!-- Conteúdo Scrollable -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_below="@id/topAppBar"
        android:layout_above="@id/btnMapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olá, Aluno!"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                tools:text="Olá, Douglas!"/>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginStart="8dp"
                    app:tint="@color/gray" />

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Buscar por nome do instrutor"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray"/>
            </LinearLayout>

            <!-- Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Preço"
                        android:textColor="@color/gray"
                        android:background="@drawable/bg_input"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingHorizontal="5dp"
                        android:text="Localização"
                        android:textColor="@color/gray"
                        android:background="@drawable/bg_input"
                        android:layout_marginStart="8dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingHorizontal="5dp"
                        android:text="Disponibilidade"
                        android:textColor="@color/gray"
                        android:background="@drawable/bg_input"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Lista de Instrutores -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/instructorRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Button -->
    <Button
        android:id="@+id/btnMapa"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:text="Ver no Mapa"
        android:backgroundTint="@color/primary"
        android:textColor="@color/black"/>
</RelativeLayout>
