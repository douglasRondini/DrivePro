<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de fundo do card -->
    <solid android:color="#F7F706" />

    <!-- Borda leve -->
    <stroke
        android:width="1dp"
        android:color="@color/gray" />

    <!-- Cantos arredondados -->
    <corners android:radius="12dp" />

    <!-- Sombra simulada com padding interno -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
